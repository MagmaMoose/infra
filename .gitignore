# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore downloaded k3s config
k3s.yaml
*secret.yaml
# ExternalSecret CRs only reference secrets in OCI Vault / 1Password — they
# contain no secret material themselves, so they are safe to commit.
!externalsecret.yaml
!github-app-magmamoose-secret.yaml
# ghcr-pull-secret.yaml here is the ExternalSecret/SecretStore mirror (SA + refs
# to the flux-system pull secret) — no secret material, safe to commit.
!ghcr-pull-secret.yaml

ansible/vars

# k3s join token written by scripts/bootstrap-franklinhouse-k3s.sh — this is a
# cluster-admin-equivalent credential and this repo is PUBLIC.
.k3s_token
**/.k3s_token

age.agekey
.service-account.json
oci_api_key.pem
oci_api_key_public.pem

*.gitignore.*
.idea/
.terragrunt-cache/
provider.tf
backend.tf

Screenshot 2025-10-11 at 20.15.25.png

Screenshot 2025-10-11 at 20.16.17.png

Screenshot 2025-10-11 at 20.17.06.png
site/
notneeded/
.neon_credentials.txtbackups/
.neon_credentials.txt

# Archive of removed-but-keep-just-in-case content
.old/

# macOS metadata
.DS_Store

# Claude Code working tree — only ephemeral state is gitignored; shared docs are tracked.
# sessions/ and decisions/ USED to be ignored here, which contradicted the line above and
# broke what CLAUDE.md promises: it lists `.claude/{decisions,sessions}/` as load-on-demand
# context, and headless agents clone this repo fresh — an ADR that never leaves one laptop is
# not a decision record. Only genuinely ephemeral state stays ignored.
.claude/worktrees/
.claude/last_output.txt

# --- AWS front door local harness (terraform/aws/localstack) ---
# The harness runs plain tofu with a LOCAL backend, so state lands next to it. It is
# LocalStack state — no real credentials — but it is also pure noise in a diff.
terraform/aws/localstack/.terraform/
terraform/aws/localstack/.terraform.lock.hcl
terraform/aws/localstack/terraform.tfstate*
terraform/aws/localstack/.outputs.json
terraform/aws/modules/*/.terraform/
terraform/aws/modules/*/_validate_provider.tf

# Folded in from .claudeignore, which was removed: a file by that name does nothing in
# Claude Code, so the coverage it claimed was never real. Only patterns git did not already
# match are listed here (verified with `git check-ignore`), and `.terraform.lock.hcl` is
# deliberately NOT among them — it is committed on purpose, 32 of them are tracked today.
*.tfplan
*.pem
*.agekey
*.log
__pycache__/
.pytest_cache/
.mypy_cache/
.coverage
.tox/
coverage/
dist/
build/
.vscode/
Thumbs.db
Screenshot*.png
